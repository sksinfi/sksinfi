# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SKS INFI SMS Notification Service
# Mobile number to receive admin lead alerts (default: 9928593122)
ADMIN_SMS_PHONE=9928593122

# Option 1: Fast2SMS (Recommended for India - Quick Transactional Route)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Option 2: Twilio (Global SMS standard)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_PHONE=+1234567890

# Option 3: Custom SMS Gateway Webhook
# SMS_GATEWAY_URL=https://api.yourgateway.com/send?to={phone}&msg={message}
# SMS_API_KEY=your_custom_gateway_key
