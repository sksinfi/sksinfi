# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SKS INFI Lead Notifications
# 1. Email Notification Recipient
ADMIN_EMAIL=infi@sksinfi.com

# Web3Forms Instant Delivery (Zero SMTP setup needed)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=d18ec79a-acd1-49fd-91aa-e1c3c0f73983
WEB3FORMS_ACCESS_KEY=d18ec79a-acd1-49fd-91aa-e1c3c0f73983

# Resend API (Alternative Modern Email API)
# RESEND_API_KEY=re_your_resend_api_key

# SMTP Server Configuration (Alternative - for sending emails via infi@sksinfi.com mail server)
# Works with your domain mail server (mail.sksinfi.com), Google Workspace, Zoho, or cPanel webmail
SMTP_HOST=mail.sksinfi.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=infi@sksinfi.com
SMTP_PASS=your_email_password
SMTP_FROM="SKS INFI Lead Alert" <infi@sksinfi.com>

# 2. SMS Notification Gateway (Choose one)
ADMIN_SMS_PHONE=9928593122
FAST2SMS_API_KEY=your_fast2sms_api_key_here
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_PHONE=+1234567890
